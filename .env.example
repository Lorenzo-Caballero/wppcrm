# ============================================================
#  wppcrm — variables de entorno
#  Copiá este archivo a .env y completá los valores reales.
#      cp .env.example .env
# ============================================================

# --- Dominio / URL pública ---------------------------------
# Va el SUBDOMINIO completo, no el dominio raíz: llegadasqr.site está
# ocupado por otro proyecto (ALIAS @ y CNAME www apuntan al CDN de Hostinger).
DOMAIN=wppcrm.llegadasqr.site
APP_URL=https://wppcrm.llegadasqr.site
LETSENCRYPT_EMAIL=lorenzocaballerofernandez@gmail.com

# --- Zona horaria (afecta la ventana de difusión) ----------
TZ=America/Argentina/Buenos_Aires

# --- Base de datos -----------------------------------------
POSTGRES_USER=wppcrm
POSTGRES_PASSWORD=cambiame_por_una_password_larga
POSTGRES_DB=wppcrm

# --- Seguridad ---------------------------------------------
# Generalo con:  openssl rand -hex 48
JWT_SECRET=cambiame_openssl_rand_hex_48
# true cuando ya tengas HTTPS andando (obligatorio en producción)
COOKIE_SECURE=true

# --- Usuario dueño de la plataforma (se crea al arrancar) ---
OWNER_EMAIL=lorenzocaballerofernandez@gmail.com
OWNER_PASSWORD=cambiame_password_inicial
OWNER_NAME=Lorenzo

# --- OpenAI (OPCIONAL) --------------------------------------
# Si está vacío el sistema igual varía los mensajes con spintax
# + diccionario de sinónimos local (sin costo, sin internet).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Límite de sesiones de WhatsApp simultáneas -------------
# Cada sesión levanta un Chromium (~400-600 MB de RAM).
# 4 GB de VPS  -> 3 a 4 sesiones
# 8 GB de VPS  -> 8 a 10 sesiones
MAX_ACTIVE_SESSIONS=4
